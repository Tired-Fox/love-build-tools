{
  "workspace": {
    "userThirdParty": [
      ".addons"
    ],
    "addons": {
      "love2d": {
        "src": "love2d",
        "target": "lua_cats"
      },
      "lovr": {
        "src": "lovr",
        "target": "lua_cats"
      }
    }
  },
  "build": {
    "name": "Blocks",
    "icons": ["Blocks.png", "Blocks.ico"],
    "targets": {
      "love": {
        "version": "11.5",
        "targets": ["win64"],
        "entry": "src/main.lua"
      },
      "lovr": {
        "version": "0.17",
        "targets": ["win64"],
        "entry": "src/main.lua"
      }
    },
    "config": {
      "window": {
        "title": "Blocks",
        "width": 280,
        "height": 500
      }
    }
  }
}
